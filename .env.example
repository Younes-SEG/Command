DATABASE_URL="postgresql://folio:folio_local@127.0.0.1:54329/folio?schema=public"
# Optional developer override. Releases bundle their shared service URL.
# End users do not need an API key or an AI account.
COMMAND_SYLLABUS_SERVICE_URL=""
# Hosted sign-in. Set these in Vercel, not in the downloaded app or a public variable.
NEON_AUTH_BASE_URL=""
# Optional owner override if the integration-managed Auth URL is locked or stuck provisioning.
COMMAND_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""
# Optional direct Neon URL for migrations. Runtime queries use DATABASE_URL.
DATABASE_URL_UNPOOLED=""
# Only needed to test hosted behavior outside Vercel. Vercel enables it automatically.
COMMAND_HOSTED="false"
