# Owner-only settings. Configure secrets in the host dashboard, never in the app package.
OPENAI_API_KEY=
OPENAI_SYLLABUS_MODEL=gpt-4.1-mini
SYLLABUS_ENABLED=false
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SYLLABUS_LIMIT_SALT=
SYLLABUS_NETWORK_DAILY=20
SYLLABUS_GLOBAL_DAILY=100
SYLLABUS_GLOBAL_MONTHLY=500
# Persistent disk; never run multiple replicas with independent quota databases.
SYLLABUS_DATA_DIR=.syllabus-service
SYLLABUS_BIND=127.0.0.1
PORT=8080
# Leave 0 unless ingress is restricted to a known proxy that appends X-Forwarded-For.
SYLLABUS_TRUST_PROXY_HOPS=0
